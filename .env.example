# ---------------------------------------------------------------------------
# Sanity CMS
# ---------------------------------------------------------------------------
# Project ID and dataset from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pin the API version to a fixed date so schema/query behaviour never shifts
# under you (see https://www.sanity.io/docs/api-versioning).
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only token with "Viewer" rights, used for:
#  - previewing draft content (not enabled in this build, reserved for future use)
#  - the seed script (scripts/seed.ts)
# Create one at https://www.sanity.io/manage -> API -> Tokens.
SANITY_API_TOKEN=

# Shared secret used to authenticate the /api/revalidate webhook that Sanity
# calls on publish. Generate any random string, e.g. `openssl rand -hex 32`.
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Contact form (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Mailbox that receives contact-form submissions.
CONTACT_FORM_TO_EMAIL=
# "From" address must be on a domain verified in Resend.
CONTACT_FORM_FROM_EMAIL=

# ---------------------------------------------------------------------------
# English translation (Azure AI Translator)
# ---------------------------------------------------------------------------
# The site is authored in Ukrainian only; the English version at /en is
# machine-translated on demand and cached — see src/lib/translate.ts. If
# these are left empty, English pages simply show the Ukrainian text
# untranslated (a soft fallback, never a broken page).
#
# Create a free "Translator" resource at https://portal.azure.com (the free
# tier includes 2,000,000 characters/month) and use its Key + endpoint here.
AZURE_TRANSLATOR_KEY=
# Default is correct for a "Global" resource. Only change this if your
# resource's "Endpoint" in the Azure portal shows a different URL.
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# Only required for a resource created in a specific Azure region rather
# than "Global" — check "Location" in the Azure portal for your resource.
AZURE_TRANSLATOR_REGION=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for sitemap.xml, canonical URLs,
# and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
